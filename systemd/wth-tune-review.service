[Unit]
Description=Watch The Hutch self-tuning review (Claude Code labels the queued frames)
After=network-online.target

[Service]
Type=oneshot
# Runs as the user Claude Code is logged in as; group wth gives it the review queue.
User=@REVIEW_USER@
SupplementaryGroups=wth
Environment=WTH_CONFIG=/etc/wth/device.toml
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=@INSTALL_DIR@
ExecStart=@INSTALL_DIR@/.venv/bin/wth-edge tune-review
Nice=10
# A long queue can take a while; one run at a time (the timer never overlaps a running one).
TimeoutStartSec=3h

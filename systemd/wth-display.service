[Unit]
Description=Watch The Hutch round status screen
# Independent of wth-edge.service on purpose: the screen says "offline" when the app is down.
After=local-fs.target

[Service]
Type=simple
User=wth
Group=wth
WorkingDirectory=@INSTALL_DIR@
Environment=PYTHONUNBUFFERED=1
# lgpio (gpiozero's Pi 5 backend) creates its notify pipe in its working directory, and
# the service user can't write to the install folder; give it a private runtime dir.
RuntimeDirectory=wth-display
Environment=LG_WD=/run/wth-display
ExecStart=@INSTALL_DIR@/.venv/bin/wth-edge display
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
